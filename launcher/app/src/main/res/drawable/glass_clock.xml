<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass slab behind the clock: translucent so the wallpaper shows through, a light rim and a
     soft top sheen. Personal build. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <solid android:color="#4D0E131C" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <gradient
                android:angle="270"
                android:startColor="#1AFFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
